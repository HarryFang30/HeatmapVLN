{
  "num_bins": {
    "translation": {
      "theta_bins": 16,
      "phi_bins": 32,
      "r_bins": 8
    },
    "rotation": {
      "roll_bins": 16,
      "pitch_bins": 16,
      "yaw_bins": 16
    }
  },
  "use_spherical": true,
  "min_sigma": 0.0,
  "action_dim": 6,
  "action_description": {
    "0": "x - forward/backward position",
    "1": "y - left/right position",
    "2": "z - up/down position",
    "3": "roll - rotation around x-axis",
    "4": "pitch - rotation around y-axis",
    "5": "yaw - rotation around z-axis"
  }
}
